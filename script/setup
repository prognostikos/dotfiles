#!/bin/bash

# Install all dotfiles into the home directory

set -e
set -o pipefail

# match hidden files when globbing children; empty dirs expand to nothing
shopt -s dotglob nullglob

DOTFILES_ROOT="$(pwd)"

if [ -z "$1" ]; then
  DEST_ROOT=$HOME
else
  DEST_ROOT="$1"
fi

# A mount point at dest can be a shared host directory (e.g. ~/.codex
# mounted into a VM) that resolves to this repo's own working tree on the
# host -- descending into it would replace tracked files with symlinks.
is_mount_point() {
  local dir="$1"
  if command -v mountpoint > /dev/null 2>&1; then
    mountpoint -q "$dir"
  else
    # macOS has no mountpoint(1); a mount point lives on a different
    # device than its parent directory
    [ "$(stat -f %d "$dir")" != "$(stat -f %d "$(dirname "$dir")")" ]
  fi
}

# Link $1 (source) to $2 (dest). If dest is a real directory and source is
# a directory too, descend and link the children into it instead of
# skipping, so a pre-existing ~/.config etc. still gets its contents.
link_entry() {
  local source="$1" dest="$2" child

  if [ -L "$dest" ]; then
    if [ "$dest" -ef "$source" ]; then
      return
    fi
    echo "Updating symlink $dest"
    rm "$dest"
  elif [ -d "$dest" ]; then
    if is_mount_point "$dest"; then
      echo "Skipping $dest (mount point)"
    elif [ -d "$source" ]; then
      for child in "$source"/*; do
        link_entry "$child" "$dest/$(basename "$child")"
      done
    else
      echo "Skipping $dest (directory exists, source is a file)"
    fi
    return
  elif [ -f "$dest" ]; then
    mv -fv "$dest" "${dest}.backup"
  fi

  ln -svf "$source" "$dest"
}

find "$DOTFILES_ROOT" -maxdepth 2 -name '*.symlink' -print0 | while IFS= read -r -d '' source
do
  dest="${DEST_ROOT}/.$(basename "${source%.*}")"

  if [ "$(basename "${source%.*}")" = "claude" ] && [ -n "$RUNNING_IN_DEVCONTAINER" ]; then
    echo "Skipping .claude symlink in devcontainer"
    continue
  fi

  link_entry "$source" "$dest"
done

if command -v fzf > /dev/null 2>&1; then
  if ! fzf --zsh > /dev/null 2>&1; then
    fzf_package_dir="/usr/share/doc/fzf/examples"

    if [ ! -r "$fzf_package_dir/key-bindings.zsh" ] || [ ! -r "$fzf_package_dir/completion.zsh" ]; then
      fzf_version=$(fzf --version | cut -d " " -f 1)
      fzf_cache_dir="${XDG_CACHE_HOME:-$DEST_ROOT/.cache}/dotfiles/fzf/$fzf_version"
      url_prefix="https://raw.githubusercontent.com/junegunn/fzf/refs/tags/$fzf_version/shell"

      mkdir -p "$fzf_cache_dir"
      echo "Installing zsh files for fzf version $fzf_version into $fzf_cache_dir"

      for fzf_shell_file in key-bindings.zsh completion.zsh; do
        if [ ! -s "$fzf_cache_dir/$fzf_shell_file" ]; then
          fzf_download_ok=false
          curl -fsSL "$url_prefix/$fzf_shell_file" -o "$fzf_cache_dir/$fzf_shell_file.tmp" && fzf_download_ok=true || true

          if [ "$fzf_download_ok" = true ] && [ -s "$fzf_cache_dir/$fzf_shell_file.tmp" ]; then
            mv "$fzf_cache_dir/$fzf_shell_file.tmp" "$fzf_cache_dir/$fzf_shell_file"
          else
            rm -f "$fzf_cache_dir/$fzf_shell_file.tmp"
          fi
        fi
      done
    fi
  fi
fi

if command -v nvim > /dev/null 2>&1; then
  if [ ! -d "${XDG_DATA_HOME:-$HOME/.local/share}/nvim/lazy/lazy.nvim" ]; then
    echo "Installing nvim plugins from lockfile"
    nvim --headless "+Lazy! restore" +qa
  fi
fi
