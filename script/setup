#!/bin/bash

# Install all dotfiles into the home directory, or into the directory given
# as the first argument. Run this script from the repository root.

set -euo pipefail

# match hidden files when globbing children; empty dirs expand to nothing
shopt -s dotglob nullglob

DOTFILES_ROOT="$(pwd)"

DEST_ROOT="${1:-$HOME}"

# A mount point at dest can be a shared host directory (e.g. ~/.codex
# mounted into a VM) that resolves to this repo's own working tree on the
# host -- descending into it would replace tracked files with symlinks.
is_mount_point() {
  local dir="$1"
  if command -v mountpoint > /dev/null 2>&1; then
    mountpoint -q "$dir"
  else
    # macOS has no mountpoint(1); a mount point lives on a different
    # device than its parent directory
    [ "$(stat -f %d "$dir")" != "$(stat -f %d "$(dirname "$dir")")" ]
  fi
}

# Link $1 (source) to $2 (dest). If dest is a real directory and source is
# a directory too, descend and link the children into it instead of
# skipping, so a pre-existing ~/.config etc. still gets its contents.
link_entry() {
  local source="$1" dest="$2" child

  if [ -L "$dest" ]; then
    if [ "$dest" -ef "$source" ]; then
      return
    fi
    echo "Updating symlink $dest"
    rm "$dest"
  elif [ -d "$dest" ]; then
    if is_mount_point "$dest"; then
      echo "Skipping $dest (mount point)"
    elif [ -d "$source" ]; then
      for child in "$source"/*; do
        link_entry "$child" "$dest/$(basename "$child")"
      done
    else
      echo "Skipping $dest (directory exists, source is a file)"
    fi
    return
  elif [ -f "$dest" ]; then
    mv -fv "$dest" "${dest}.backup"
  fi

  ln -svf "$source" "$dest"
}

find "$DOTFILES_ROOT" -maxdepth 2 -path "$DOTFILES_ROOT/test" -prune -o \
  -name '*.symlink' -print0 | while IFS= read -r -d '' source
do
  link_entry "$source" "$DEST_ROOT/.$(basename "${source%.symlink}")"
done

# Claude reads skills only from ~/.claude/skills, so link each shared skill
# there. The links are relative, because the home path in a container differs
# from the home path on the host. On the host, ~/.claude is a symlink to
# claude.symlink, and the .agents link in the repository root makes the same
# relative path correct there.
mkdir -p "$DEST_ROOT/.claude/skills"
for skill in "$DEST_ROOT/.agents/skills"/*; do
  [ -f "$skill/SKILL.md" ] || continue
  skill_name="$(basename "$skill")"
  skill_link="$DEST_ROOT/.claude/skills/$skill_name"
  skill_target="../../.agents/skills/$skill_name"
  if [ -L "$skill_link" ] && [ "$(readlink "$skill_link")" = "$skill_target" ]; then
    continue
  fi
  if [ -e "$skill_link" ] || [ -L "$skill_link" ]; then
    echo "Skipping shared skill $skill_name (Claude skill already exists)"
    continue
  fi
  ln -sv "$skill_target" "$skill_link"
done

# An old fzf has no --zsh option. fzf/completion.sh then reads the zsh files
# from the Debian package or from this cache.
install_fzf_zsh_files() {
  local package_dir="/usr/share/doc/fzf/examples" version cache_dir url_prefix file

  if fzf --zsh > /dev/null 2>&1; then
    return
  fi
  if [ -r "$package_dir/key-bindings.zsh" ] && [ -r "$package_dir/completion.zsh" ]; then
    return
  fi

  version=$(fzf --version | cut -d " " -f 1)
  cache_dir="${XDG_CACHE_HOME:-$DEST_ROOT/.cache}/dotfiles/fzf/$version"
  url_prefix="https://raw.githubusercontent.com/junegunn/fzf/refs/tags/$version/shell"
  mkdir -p "$cache_dir"

  for file in key-bindings.zsh completion.zsh; do
    if [ -s "$cache_dir/$file" ]; then
      continue
    fi
    echo "Installing $file for fzf version $version into $cache_dir"
    # A failed download must not stop the setup.
    if curl -fsSL "$url_prefix/$file" -o "$cache_dir/$file.tmp" && [ -s "$cache_dir/$file.tmp" ]; then
      mv "$cache_dir/$file.tmp" "$cache_dir/$file"
    else
      rm -f "$cache_dir/$file.tmp"
    fi
  done
}

if command -v fzf > /dev/null 2>&1; then
  install_fzf_zsh_files
fi

if command -v nvim > /dev/null 2>&1; then
  if [ ! -d "${XDG_DATA_HOME:-$HOME/.local/share}/nvim/lazy/lazy.nvim" ]; then
    echo "Installing nvim plugins from lockfile"
    nvim --headless "+Lazy! restore" +qa
  fi
fi
