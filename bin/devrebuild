#!/bin/bash

set -euo pipefail

# shellcheck source=bin/.worktree-layout
# shellcheck disable=SC1091
source "$(dirname "${BASH_SOURCE[0]}")/.worktree-layout"

# shellcheck source=bin/.devcontainer-config
# shellcheck disable=SC1091
source "$(dirname "${BASH_SOURCE[0]}")/.devcontainer-config"

usage() {
  cat <<'EOF'
Usage: devrebuild [--nuke] [--no-cache]

Rebuild the devcontainer for the current directory.

Options:
  --nuke       Remove the devcontainer and its volumes before the rebuild
  --no-cache   Build without cached layers. For an image-based configuration,
               this does NOT pull a new image. Run docker pull <image> first.
               Dockerfile builds can also pull base images, depending on the
               CLI build path.
EOF
}

# Remove the containers of this workspace and the volumes they use. The
# container labels identify a Compose project, so this does not read the
# Compose file. A Compose file needs its env_file, which can be absent here.
nuke() {
  local container_ids compose_project volumes

  echo "Nuking devcontainer for $MAIN_REPO..."

  container_ids=$(docker ps -aq --filter "label=devcontainer.local_folder=$MAIN_REPO")
  if [ -z "$container_ids" ]; then
    echo "No containers found."
    return
  fi

  # shellcheck disable=SC2086
  compose_project=$(
    docker inspect \
      --format '{{index .Config.Labels "com.docker.compose.project"}}' \
      $container_ids | head -n 1
  )

  if [ -n "$compose_project" ]; then
    docker compose --project-name "$compose_project" \
      down --volumes --remove-orphans
  else
    # shellcheck disable=SC2086
    volumes=$(
      docker inspect \
        --format '{{range .Mounts}}{{if eq .Type "volume"}}{{println .Name}}{{end}}{{end}}' \
        $container_ids
    )
    # shellcheck disable=SC2086
    docker rm -f $container_ids
    if [ -n "$volumes" ]; then
      # shellcheck disable=SC2086
      docker volume rm $volumes
    fi
  fi

  echo "Nuke complete."
}

if [ -n "${RUNNING_IN_DEVCONTAINER:-}" ]; then
  echo "Already inside a devcontainer" >&2
  exit 1
fi

NUKE=false
UP_ARGS=()

for arg in "$@"; do
  case "$arg" in
    --nuke)
      NUKE=true
      ;;
    --no-cache)
      UP_ARGS+=(--build-no-cache)
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $arg" >&2
      usage >&2
      exit 1
      ;;
  esac
done

wt_resolve_current_worktree
MAIN_REPO="$WT_MAIN_WORKTREE"

devcontainer_resolve_workspace "$MAIN_REPO"

# Priority: DEVCONTAINER_USER env var > devcontainer.json remoteUser > default
if [ -z "${DEVCONTAINER_USER:-}" ]; then
  # jq cannot read a configuration that contains comments.
  DEVCONTAINER_USER=$(jq -r '.remoteUser // empty' "$DEVCONTAINER_CONFIG_FILE") || {
    echo "Cannot read remoteUser from $DEVCONTAINER_CONFIG_FILE. Set DEVCONTAINER_USER." >&2
    exit 1
  }
  DEVCONTAINER_USER=${DEVCONTAINER_USER:-vscode}
fi

if [ "$NUKE" = true ]; then
  nuke
fi

for dir in .agents .claude .codex; do
  mkdir -p "$HOME/$dir"
  UP_ARGS+=(--mount "type=bind,source=$HOME/$dir,target=/home/$DEVCONTAINER_USER/$dir")
done

# A nested .worktrees directory is already included in the main workspace bind.
# Only the sibling layout needs an additional mount.
SIBLING_WORKTREES_DIR="${MAIN_REPO}-worktrees"
if [ "$(wt_worktrees_dir "$MAIN_REPO")" = "$SIBLING_WORKTREES_DIR" ] && [ -d "$SIBLING_WORKTREES_DIR" ]; then
  UP_ARGS+=(--mount "type=bind,source=$SIBLING_WORKTREES_DIR,target=/workspaces/$(basename "$SIBLING_WORKTREES_DIR")")
fi

# Compose files reference ../.env, which resolves to the repository root.
# When that file is missing and a 1Password service account token is available
# in the environment or /etc/op/token (root-only), generate it
# from a 1Password environment for the duration of this script. The trap
# removes it again, so the secrets never stay on disk.
ENV_FILE="$MAIN_REPO/.env"
if [ ! -f "$ENV_FILE" ]; then
  OP_TOKEN=${OP_SERVICE_ACCOUNT_TOKEN:-}
  if [ -z "$OP_TOKEN" ] && [ -d /etc/op ] && sudo test -f /etc/op/token; then
    OP_TOKEN=$(sudo cat /etc/op/token)
  fi

  if [ -n "$OP_TOKEN" ]; then
    echo "Generating $ENV_FILE from 1Password (removed on exit)..."
    trap 'rm -f "$ENV_FILE"' EXIT
    (
      umask 077
      OP_SERVICE_ACCOUNT_TOKEN="$OP_TOKEN" \
        op environment read "${OP_ENVIRONMENT_ID:-os2pfekn55ky2d6uptjrgvvgm4}" > "$ENV_FILE"
    )
  fi
  unset OP_TOKEN
fi
unset OP_SERVICE_ACCOUNT_TOKEN

devcontainer up \
  "${DEVCONTAINER_WORKSPACE_ARGS[@]}" \
  --remove-existing-container \
  --dotfiles-repository https://github.com/prognostikos/dotfiles \
  --dotfiles-install-command script/setup \
  --dotfiles-target-path "/home/$DEVCONTAINER_USER/.dotfiles" \
  "${UP_ARGS[@]}"
