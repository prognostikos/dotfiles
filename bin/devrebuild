#!/bin/bash

set -euo pipefail

# shellcheck source=bin/.worktree-layout
# shellcheck disable=SC1091
source "$(dirname "${BASH_SOURCE[0]}")/.worktree-layout"

usage() {
  echo "Usage: devrebuild [--nuke] [--no-cache]"
  echo ""
  echo "Rebuild the devcontainer for the current directory."
  echo ""
  echo "Options:"
  echo "  --nuke       Completely remove the devcontainer including volumes before rebuilding"
  echo "  --no-cache   Build the image without using cache (pulls fresh base image)"
  exit 1
}

# Get remoteUser from devcontainer.json
get_remote_user() {
  local devcontainer_json=""
  if [ -f "$MAIN_REPO/.devcontainer/devcontainer.json" ]; then
    devcontainer_json="$MAIN_REPO/.devcontainer/devcontainer.json"
  elif [ -f "$MAIN_REPO/.devcontainer.json" ]; then
    devcontainer_json="$MAIN_REPO/.devcontainer.json"
  fi

  if [ -n "$devcontainer_json" ]; then
    jq -r '.remoteUser // empty' "$devcontainer_json"
  fi
}

NUKE=false
NO_CACHE=false

# Parse arguments
while [[ $# -gt 0 ]]; do
  case $1 in
    --nuke)
      NUKE=true
      shift
      ;;
    --no-cache)
      NO_CACHE=true
      shift
      ;;
    -h|--help)
      usage
      ;;
    *)
      echo "Unknown option: $1"
      usage
      ;;
  esac
done

# Resolve the main checkout even when invoked from a linked worktree whose Git
# pointers currently refer to the other side of the host/container boundary.
if git rev-parse --git-common-dir &>/dev/null; then
  MAIN_REPO="$(wt_main_worktree)"
elif wt_find_broken_worktree "$PWD"; then
  MAIN_REPO="$WT_BROKEN_MAIN_WORKTREE"
else
  MAIN_REPO="$(pwd -P)"
fi

PROJECT_DIR="$(basename "$MAIN_REPO")"
WORKTREES_DIR="$(wt_worktrees_dir "$MAIN_REPO")"
SIBLING_WORKTREES_DIR="$(dirname "$MAIN_REPO")/${PROJECT_DIR}-worktrees"

# Priority: DEVCONTAINER_USER env var > devcontainer.json remoteUser > default
DEVCONTAINER_USER=${DEVCONTAINER_USER:-$(get_remote_user)}
DEVCONTAINER_USER=${DEVCONTAINER_USER:-vscode}

# Nuke existing devcontainer if requested
if [ "$NUKE" = true ]; then
  echo "Nuking devcontainer for $PROJECT_DIR..."

  # Check if using docker-compose
  COMPOSE_FILE=""
  if [ -f "$MAIN_REPO/.devcontainer/compose.yml" ]; then
    COMPOSE_FILE="$MAIN_REPO/.devcontainer/compose.yml"
  elif [ -f "$MAIN_REPO/.devcontainer/docker-compose.yml" ]; then
    COMPOSE_FILE="$MAIN_REPO/.devcontainer/docker-compose.yml"
  fi

  if [ -n "$COMPOSE_FILE" ]; then
    echo "Removing containers and volumes via docker compose..."
    docker compose -f "$COMPOSE_FILE" down -v --remove-orphans
  else
    # Fallback for non-compose devcontainers
    CONTAINER_FILTER="label=devcontainer.local_folder=$MAIN_REPO"
    CONTAINER_IDS=$(docker ps -aq --filter "$CONTAINER_FILTER" 2>/dev/null || true)
    if [ -n "$CONTAINER_IDS" ]; then
      echo "Removing containers..."
      # shellcheck disable=SC2086
      docker rm -f $CONTAINER_IDS
    else
      echo "No containers found matching filter: $CONTAINER_FILTER"
    fi

    VOLUME_FILTER="name=vsc-${PROJECT_DIR}-"
    VOLUMES=$(docker volume ls -q --filter "$VOLUME_FILTER" 2>/dev/null || true)
    if [ -n "$VOLUMES" ]; then
      echo "Removing volumes..."
      # shellcheck disable=SC2086
      docker volume rm $VOLUMES
    else
      echo "No volumes found matching filter: $VOLUME_FILTER"
    fi
  fi

  echo "Nuke complete."
fi

# Build mount arguments
MOUNT_ARGS=(
  --mount "type=bind,source=${HOME}/.claude,target=/home/${DEVCONTAINER_USER}/.claude"
  --mount "type=bind,source=${HOME}/.agents,target=/home/${DEVCONTAINER_USER}/.agents"
  --mount "type=bind,source=${HOME}/.codex,target=/home/${DEVCONTAINER_USER}/.codex"
)

# A nested .worktrees directory is already included in the main workspace bind.
# Only the sibling layout needs an additional mount.
if [ "$WORKTREES_DIR" = "$SIBLING_WORKTREES_DIR" ] && [ -d "$WORKTREES_DIR" ]; then
  MOUNT_ARGS+=(--mount "type=bind,source=${WORKTREES_DIR},target=/workspaces/${PROJECT_DIR}-worktrees")
fi

DEVCONTAINER_ARGS=()
if [ "$NO_CACHE" = true ]; then
  DEVCONTAINER_ARGS+=(--build-no-cache)
fi

# Compose files reference ../.env, which resolves to the repository root.
# When that file is missing on a host that provision-exe-vm gave a
# 1Password service account token (/etc/op/token, root-only), generate it
# from a 1Password environment for the duration of this script. The trap
# removes it again, so the secrets never stay on disk.
ENV_FILE="$MAIN_REPO/.env"
if [ ! -f "$ENV_FILE" ] && [ -d /etc/op ] && sudo test -f /etc/op/token; then
  echo "Generating $ENV_FILE from 1Password (removed on exit)..."
  OP_SERVICE_ACCOUNT_TOKEN=$(sudo cat /etc/op/token)
  export OP_SERVICE_ACCOUNT_TOKEN
  trap 'rm -f "$ENV_FILE"' EXIT
  (umask 077; op environment read "${OP_ENVIRONMENT_ID:-os2pfekn55ky2d6uptjrgvvgm4}" > "$ENV_FILE")
  unset OP_SERVICE_ACCOUNT_TOKEN
fi

devcontainer up \
  --workspace-folder "$MAIN_REPO" \
  --remove-existing-container \
  --dotfiles-repository https://github.com/prognostikos/dotfiles \
  --dotfiles-install-command script/setup \
  --dotfiles-target-path "/home/$DEVCONTAINER_USER/.dotfiles" \
  "${MOUNT_ARGS[@]}" \
  ${DEVCONTAINER_ARGS[@]+"${DEVCONTAINER_ARGS[@]}"}
