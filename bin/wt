#!/bin/bash

set -euo pipefail

# shellcheck source=bin/.worktree-layout
# shellcheck disable=SC1091
source "$(dirname "${BASH_SOURCE[0]}")/.worktree-layout"

# Files to symlink from main worktree
WT_LINK_FILES="${WT_LINK_FILES:-.env}"
# Directories to copy with hard links from main worktree
WT_COPY_DIRS="${WT_COPY_DIRS:-vendor/bundle node_modules}"

usage() {
  echo "Usage: wt [<branch-name> [base-branch]]" >&2
  echo "" >&2
  echo "  Create a git worktree in a sibling <repo>-worktrees directory or" >&2
  echo "  a .worktrees directory inside the main worktree." >&2
  echo "  With no arguments, select an existing worktree via fzf." >&2
  echo "  base-branch defaults to the default branch (auto-detected)." >&2
  echo "" >&2
  echo "Environment variables:" >&2
  echo "  WT_LINK_FILES      Files to symlink from main worktree (default: .env)" >&2
  echo "  WT_COPY_DIRS       Dirs to copy with hard links (default: vendor/bundle node_modules)" >&2
  echo "  NEW_WORKTREE_CMD   Command to run after creating a new worktree (default: bin/new-worktree)" >&2
  exit 1
}

select_existing_worktree() {
  local selected
  local entries=()

  # Called indirectly by wt_each_worktree.
  # shellcheck disable=SC2317
  append_entry() {
    local local_path="$2"
    local head="$3"
    local branch="$4"
    local name

    if [ -n "$branch" ]; then
      name="${branch#refs/heads/}"
    else
      name="$(basename "$local_path")"
    fi

    entries+=("$(printf '%s\t%s\t%s' "$local_path" "$name" "$head")")
  }

  wt_each_worktree \
    "$MAIN_WORKTREE" "$WORKTREES_DIR" true append_entry

  if [ "${#entries[@]}" -le 1 ]; then
    echo "No additional worktrees found." >&2
    echo "" >&2
    usage
  fi

  selected="$(
    printf '%s\n' "${entries[@]}" |
      fzf --delimiter=$'\t' --with-nth=2.. --prompt='Select worktree: '
  )" || exit 0

  selected="${selected%%$'\t'*}"

  if [ -z "$selected" ]; then
    exit 0
  fi

  cd "$selected"
  tat
}

construct_worktree_path() {
  WORKTREE_PATH="$WORKTREES_DIR/$BRANCH_NAME"

  if [ ! -d "$WORKTREES_DIR" ]; then
    echo "Creating worktrees directory: $WORKTREES_DIR"
    mkdir -p "$WORKTREES_DIR"
  fi
}

attach_to_existing_worktree() {
  if [ -d "$WORKTREE_PATH" ]; then
    local is_registered=false

    # Called indirectly by wt_each_worktree.
    # shellcheck disable=SC2317
    find_registered_worktree() {
      local local_path="$2"

      if [ "$local_path" = "$WORKTREE_PATH" ]; then
        is_registered=true
      fi
    }

    wt_each_worktree \
      "$MAIN_WORKTREE" "$WORKTREES_DIR" false find_registered_worktree

    if [ "$is_registered" = true ]; then
      echo "Worktree already exists: $WORKTREE_PATH"
      cd "$WORKTREE_PATH"
      tat
      exit 0
    else
      echo "Error: Directory exists but is not a valid worktree: $WORKTREE_PATH" >&2
      echo "Remove it manually or use 'git worktree prune' if it's stale" >&2
      exit 1
    fi
  fi
}

create_new_worktree() {
  echo "Creating git worktree: $WORKTREE_PATH"

  if git show-ref --verify --quiet "refs/heads/$BRANCH_NAME"; then
    echo "Branch '$BRANCH_NAME' already exists, using existing branch"
    git worktree add "$WORKTREE_PATH" "$BRANCH_NAME"
  else
    echo "Creating new branch '$BRANCH_NAME' from '$BASE_BRANCH'"
    git worktree add -b "$BRANCH_NAME" "$WORKTREE_PATH" "$BASE_BRANCH"
  fi
}

link_files() {
  for file in $WT_LINK_FILES; do
    if [ -f "$MAIN_WORKTREE/$file" ]; then
      echo "Linking $file"
      ln -sf "$MAIN_WORKTREE/$file" "$WORKTREE_PATH/$file"
    fi
  done
}

copy_dirs() {
  for dir in $WT_COPY_DIRS; do
    if [ -d "$MAIN_WORKTREE/$dir" ]; then
      echo "Copying $dir with hard links"
      mkdir -p "$WORKTREE_PATH/$dir"
      cp -Rc "$MAIN_WORKTREE/$dir/." "$WORKTREE_PATH/$dir/" 2>/dev/null \
        || cp -rl "$MAIN_WORKTREE/$dir/." "$WORKTREE_PATH/$dir/" 2>/dev/null \
        || cp -R "$MAIN_WORKTREE/$dir/." "$WORKTREE_PATH/$dir/"
    fi
  done
}

authorize_envrc() {
  if [ -f "$WORKTREE_PATH/.envrc" ]; then
    read -r -p "Do you trust the .envrc in the worktree? [y/N]: " response
    case "$response" in
      [yY][eE][sS]|[yY])
        direnv allow "$WORKTREE_PATH"
        ;;
      *)
        ;;
    esac
  fi
}

run_new_worktree_cmd() {
  local cmd="${NEW_WORKTREE_CMD:-bin/new-worktree}"
  if [ -x "$WORKTREE_PATH/$cmd" ]; then
    echo "Running $cmd"
    (cd "$WORKTREE_PATH" && "./$cmd")
  fi
}

# Main flow

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
  usage
fi

MAIN_WORKTREE="$(wt_main_worktree)"
WORKTREES_DIR="$(wt_worktrees_dir "$MAIN_WORKTREE")"

if [ $# -eq 0 ]; then
  select_existing_worktree
  exit 0
fi

BRANCH_NAME="$1"
DEFAULT_BRANCH=$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's@^refs/remotes/origin/@@' || echo master)
BASE_BRANCH="${2:-$DEFAULT_BRANCH}"

construct_worktree_path
attach_to_existing_worktree
create_new_worktree
link_files
copy_dirs
authorize_envrc
run_new_worktree_cmd

cd "$WORKTREE_PATH"
tat
