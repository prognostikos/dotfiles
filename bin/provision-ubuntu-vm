#!/bin/bash

# Idempotent package and tool installation for an Ubuntu (noble) machine.
# Safe to re-run: repos are added once, packages install only when
# missing. Used by provision-exe-vm for exe.dev VMs, but has nothing
# exe-specific and works on any Ubuntu box with sudo.

set -euo pipefail

# apt package names (not command names), sorted
desired_packages=(
  1password-cli
  bat
  direnv
  dnsutils
  fd-find
  fzf
  gh
  git-delta
  gnupg2
  htop
  jq
  lsof
  net-tools
  nodejs
  postgresql-client
  ripgrep
  ruby
  shellcheck
  socat
  strace
  tig
  tmux
  tofu
  tree
  tree
  universal-ctags
  unzip
  zsh
)

missing_packages=()
for package in "${desired_packages[@]}"; do
  if ! dpkg -s "$package" > /dev/null 2>&1; then
    missing_packages+=("$package")
  fi
done

# gh in the Ubuntu repos is old; add GitHub's official apt repo
# per https://github.com/cli/cli/blob/trunk/docs/install_linux.md
# on first setup force-install gh so a preinstalled version upgrades
if [ ! -f /etc/apt/sources.list.d/github-cli.list ]; then
  sudo install -m 0755 -d /etc/apt/keyrings
  curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg |
    sudo tee /etc/apt/keyrings/githubcli-archive-keyring.gpg > /dev/null
  sudo chmod a+r /etc/apt/keyrings/githubcli-archive-keyring.gpg
  echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" |
    sudo tee /etc/apt/sources.list.d/github-cli.list > /dev/null
  sudo chmod a+r /etc/apt/sources.list.d/github-cli.list
  missing_packages+=(gh)
fi

# node in the Ubuntu repos is old; add the NodeSource repo for the
# current LTS; on first setup force-install so a preinstalled version
# upgrades
if [ ! -f /etc/apt/sources.list.d/nodesource.list ]; then
  curl -fsSL https://deb.nodesource.com/setup_lts.x | sudo bash -
  missing_packages+=(nodejs)
fi

# tofu (OpenTofu) is not in the Ubuntu repos; add the OpenTofu apt repo
# per https://opentofu.org/docs/intro/install/deb/
if [ ! -f /etc/apt/sources.list.d/opentofu.list ]; then
  sudo install -m 0755 -d /etc/apt/keyrings
  curl -fsSL https://get.opentofu.org/opentofu.gpg |
    sudo tee /etc/apt/keyrings/opentofu.gpg > /dev/null
  curl -fsSL https://packages.opentofu.org/opentofu/tofu/gpgkey |
    sudo gpg --no-tty --batch --dearmor -o /etc/apt/keyrings/opentofu-repo.gpg > /dev/null
  sudo chmod a+r /etc/apt/keyrings/opentofu.gpg /etc/apt/keyrings/opentofu-repo.gpg
  echo "deb [signed-by=/etc/apt/keyrings/opentofu.gpg,/etc/apt/keyrings/opentofu-repo.gpg] https://packages.opentofu.org/opentofu/tofu/any/ any main" |
    sudo tee /etc/apt/sources.list.d/opentofu.list > /dev/null
  sudo chmod a+r /etc/apt/sources.list.d/opentofu.list
fi

# the 1password op cli is not in the Ubuntu repos; add 1Password's apt repo
# per https://developer.1password.com/docs/cli/get-started/ but use the
# beta channel for the latest beta builds
if [ ! -f /etc/apt/sources.list.d/1password.list ]; then
  arch=$(dpkg --print-architecture)
  curl -fsSL https://downloads.1password.com/linux/keys/1password.asc |
    sudo gpg --no-tty --batch --dearmor -o /usr/share/keyrings/1password-archive-keyring.gpg
  echo "deb [arch=$arch signed-by=/usr/share/keyrings/1password-archive-keyring.gpg] https://downloads.1password.com/linux/debian/$arch beta main" |
    sudo tee /etc/apt/sources.list.d/1password.list > /dev/null
  sudo install -m 0755 -d /etc/debsig/policies/AC2D62742012EA22 /usr/share/debsig/keyrings/AC2D62742012EA22
  curl -fsSL https://downloads.1password.com/linux/debian/debsig/1password.pol |
    sudo tee /etc/debsig/policies/AC2D62742012EA22/1password.pol > /dev/null
  curl -fsSL https://downloads.1password.com/linux/keys/1password.asc |
    sudo gpg --no-tty --batch --dearmor -o /usr/share/debsig/keyrings/AC2D62742012EA22/debsig.gpg
elif grep -q " stable " /etc/apt/sources.list.d/1password.list; then
  # switch a VM provisioned before the channel change over to beta and
  # force-install so the stable version upgrades
  sudo sed -i 's/ stable / beta /' /etc/apt/sources.list.d/1password.list
  missing_packages+=(1password-cli)
fi

if [ "${#missing_packages[@]}" -gt 0 ]; then
  sudo DEBIAN_FRONTEND=noninteractive apt-get update
  sudo DEBIAN_FRONTEND=noninteractive apt-get install -y "${missing_packages[@]}"
fi

# neovim in the Ubuntu repos is too old for the nvim config and the
# neovim-ppa has no noble builds; remove the apt version and install
# the official tarball (delete /usr/local/bin/nvim to force an update)
if [ ! -x /usr/local/bin/nvim ]; then
  if dpkg -s neovim > /dev/null 2>&1; then
    sudo DEBIAN_FRONTEND=noninteractive apt-get remove -y neovim neovim-runtime
  fi
  case "$(uname -m)" in
    aarch64) nvim_arch=arm64 ;;
    *) nvim_arch=x86_64 ;;
  esac
  curl -fsSL "https://github.com/neovim/neovim/releases/latest/download/nvim-linux-${nvim_arch}.tar.gz" -o /tmp/nvim.tar.gz
  sudo rm -rf /opt/nvim-linux-"$nvim_arch"
  sudo tar -C /opt -xzf /tmp/nvim.tar.gz
  sudo ln -sf "/opt/nvim-linux-${nvim_arch}/bin/nvim" /usr/local/bin/nvim
  rm /tmp/nvim.tar.gz
fi

# aws cli v2 has no official apt repo; use the official bundle installer
if ! command -v aws > /dev/null 2>&1; then
  curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-$(uname -m).zip" -o /tmp/awscliv2.zip
  unzip -q /tmp/awscliv2.zip -d /tmp
  sudo /tmp/aws/install
  rm -rf /tmp/awscliv2.zip /tmp/aws
fi

# herdr
if ! command -v herdr > /dev/null 2>&1; then
  curl -fsSL https://herdr.dev/install.sh | sh
fi

# devcontainer cli (needs the nodejs installed above)
if ! command -v devcontainer > /dev/null 2>&1; then
  sudo npm install -g @devcontainers/cli
fi

# Ubuntu installs bat and fd under different command names
mkdir -p "$HOME/.local/bin"
if command -v batcat > /dev/null 2>&1 && ! command -v bat > /dev/null 2>&1; then
  ln -sf "$(command -v batcat)" "$HOME/.local/bin/bat"
fi
if command -v fdfind > /dev/null 2>&1 && ! command -v fd > /dev/null 2>&1; then
  ln -sf "$(command -v fdfind)" "$HOME/.local/bin/fd"
fi

echo "✓ Ubuntu provisioning complete"
