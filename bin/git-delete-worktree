#!/usr/bin/env bash

set -euo pipefail

# shellcheck source=bin/.worktree-layout
# shellcheck disable=SC1091
source "$(dirname "${BASH_SOURCE[0]}")/.worktree-layout"

if ! command -v fzf >/dev/null 2>&1; then
  echo "fzf is required" >&2
  exit 1
fi

if ! git rev-parse --git-dir >/dev/null 2>&1; then
  echo "Not in a git repository" >&2
  exit 1
fi

MAIN_WORKTREE="$(wt_main_worktree)"
WORKTREES_DIR="$(wt_worktrees_dir "$MAIN_WORKTREE")"

entries=()

# Called indirectly by wt_each_worktree.
# shellcheck disable=SC2317
append_entry() {
  local registered_path="$1"
  local local_path="$2"
  local head="$3"
  local branch="$4"
  local branch_name

  if [ -n "$branch" ]; then
    branch_name="${branch#refs/heads/}"
  else
    branch_name="$(basename "$local_path")"
  fi

  entries+=("$(
    printf '%s\t%s\t%s' "$registered_path" "$branch_name" "$head"
  )")
}

wt_each_worktree \
  "$MAIN_WORKTREE" "$WORKTREES_DIR" false append_entry

if [ "${#entries[@]}" -eq 0 ]; then
  echo "No worktrees found." >&2
  exit 1
fi

selected="$(
  printf '%s\n' "${entries[@]}" |
    fzf --delimiter=$'\t' --with-nth=2.. --prompt='Remove worktree: '
)" || exit 0

selected_path="${selected%%$'\t'*}"
selected_rest="${selected#*$'\t'}"
selected_name="${selected_rest%%$'\t'*}"

# Intentionally no --force so git blocks removal when there are unmerged changes.
if ! git worktree remove "$selected_path"; then
  exit 1
fi

if command -v tmux >/dev/null 2>&1; then
  if tmux has-session -t "$selected_name" 2>/dev/null; then
    tmux kill-session -t "$selected_name"
  fi
fi
