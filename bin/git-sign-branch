#!/bin/bash

set -euo pipefail

usage() {
  echo 'Usage: git sign-branch [<base> [<branch>]]' >&2
  echo '       git sign-branch --all [<branch>]' >&2
  echo '       git sign-branch --stack <base>' >&2
  echo 'Stack mode: check out the top branch first. All local branches in <base>..HEAD are updated, including backup branches.' >&2
}

check_stack() {
  local ref tip upstream remote_ref remote_tip remote_name local_ref found
  local worktrees local_refs remote_refs

  if ! git symbolic-ref --quiet HEAD >/dev/null; then
    echo 'Stack mode requires a checked-out top branch.' >&2
    exit 1
  fi
  if ! base="$(git rev-parse --verify "$base^{commit}")"; then
    echo 'Stack mode requires a valid base commit.' >&2
    exit 1
  fi
  if ! git merge-base --is-ancestor "$base" HEAD; then
    echo 'The stack base must be an ancestor of HEAD.' >&2
    exit 1
  fi
  rebase_merge_path="$(git rev-parse --git-path rebase-merge)"
  rebase_apply_path="$(git rev-parse --git-path rebase-apply)"
  if [[ -d "$rebase_merge_path" || -d "$rebase_apply_path" ]]; then
    echo 'Refusing to sign commits while a rebase is already in progress.' >&2
    exit 1
  fi
  if ! git diff --quiet -- || ! git diff --cached --quiet --; then
    echo 'Refusing to sign commits with tracked index or worktree changes.' >&2
    exit 1
  fi

  worktrees="$(git worktree list --porcelain)"
  local_refs="$(git for-each-ref --format='%(refname) %(objectname) %(upstream)' refs/heads/)"
  remote_refs="$(git for-each-ref --format='%(refname) %(objectname) %(symref)' refs/remotes/)"
  while read -r ref tip upstream; do
    [[ -n "$ref" ]] || continue
    if in_stack_range "$tip"; then
      if [[ "$ref" != "$(git symbolic-ref HEAD)" ]] \
        && grep -qxF "branch $ref" <<<"$worktrees"; then
        echo "Refusing to sign the stack: '${ref#refs/heads/}' is checked out in another worktree." >&2
        exit 1
      fi
    fi
  done <<<"$local_refs"

  # Git cannot update remote-tracking refs. Check fetched branch tips in the
  # range against their local tracking branch (or a branch with the same name).
  while read -r remote_ref remote_tip ref; do
    [[ -n "$remote_ref" && -z "$ref" ]] || continue
    in_stack_range "$remote_tip" || continue
    remote_name="${remote_ref#refs/remotes/}"
    local_ref="refs/heads/${remote_name#*/}"
    found=false
    while read -r ref tip upstream; do
      if [[ "$upstream" == "$remote_ref" || "$ref" == "$local_ref" ]]; then
        if in_stack_range "$tip" && git merge-base --is-ancestor "$remote_tip" "$tip"; then
          found=true
          break
        fi
      fi
    done <<<"$local_refs"
    if [[ "$found" != true ]]; then
      echo "No local stack branch contains '$remote_name'. Fetch and check out the complete stack first." >&2
      exit 1
    fi
  done <<<"$remote_refs"

  echo 'Stack mode will update these local branches (including any backup branches):' >&2
  while read -r ref tip upstream; do
    [[ -n "$ref" ]] || continue
    if in_stack_range "$tip"; then
      printf '  %s\n' "${ref#refs/heads/}" >&2
    fi
  done <<<"$local_refs"
}

in_stack_range() {
  git merge-base --is-ancestor "$1" HEAD \
    && ! git merge-base --is-ancestor "$1" "$base"
}

stack_recovery_message() {
  if [[ -d "$rebase_merge_path" || -d "$rebase_apply_path" ]]; then
    echo 'Stack rebase stopped. Fix the cause, then run git rebase --continue, or use git rebase --abort to cancel.' >&2
  else
    echo 'Check git status and the stack branch refs before you retry.' >&2
  fi
}

handle_stack_interrupt() {
  local status="$1"
  trap - INT TERM
  stack_recovery_message
  exit "$status"
}

has_signature() {
  local commit="$1"
  local line

  while IFS= read -r line; do
    if [[ -z "$line" ]]; then
      break
    fi
    if [[ "$line" == 'gpgsig '* ]]; then
      return 0
    fi
  done < <(git cat-file commit "$commit")

  return 1
}

cleanup_temp() {
  if [[ -n "${temp_dir:-}" && -d "$temp_dir" ]]; then
    rm -rf "$temp_dir"
  fi
}

cleanup_worktree() {
  if [[ -z "${worktree_dir:-}" || ! -d "$worktree_dir" ]]; then
    return 0
  fi
  if [[ -d "$(git -C "$worktree_dir" rev-parse --git-path rebase-merge)" \
    || -d "$(git -C "$worktree_dir" rev-parse --git-path rebase-apply)" ]]; then
    git -C "$worktree_dir" rebase --abort >/dev/null 2>&1 || true
  fi
  git worktree remove --force "$worktree_dir" >/dev/null 2>&1 || true
}

cleanup_all() {
  cleanup_worktree
  cleanup_temp
}

restore_original_history() {
  local current_head
  local current_ref

  if [[ "$mode" != all || "$owns_rebase" != true ]]; then
    return 0
  fi
  if [[ -d "$rebase_merge_path" || -d "$rebase_apply_path" ]]; then
    if ! git rebase --abort; then
      return 1
    fi
  fi

  current_ref="$(git symbolic-ref --quiet HEAD 2>/dev/null || true)"
  if [[ "$current_ref" != "$original_ref" ]]; then
    return 1
  fi

  current_head="$(git rev-parse HEAD)"
  if [[ "$current_head" != "$original_head" ]]; then
    if ! git reset --hard "$original_head"; then
      return 1
    fi
  fi

  [[ "$(git rev-parse HEAD)" == "$original_head" ]]
}

handle_interrupt() {
  local abort_status=0
  local abort_output=''

  trap - EXIT INT
  if abort_output="$(restore_original_history 2>&1)"; then
    echo 'Interrupted by INT; restored the original history.' >&2
  else
    abort_status=$?
    printf 'Interrupted by INT; unable to restore the original history:\n%s\n' \
      "$abort_output" >&2
  fi
  cleanup_temp

  if (( abort_status != 0 )); then
    exit "$abort_status"
  fi
  exit 130
}

handle_worktree_interrupt() {
  trap - EXIT INT
  cleanup_all
  echo "Interrupted by INT; branch '$branch' did not change." >&2
  exit 130
}

mode=range
base=''
branch=''
use_worktree=false
worktree_dir=''
original_tip=''
owns_rebase=false
rebase_merge_path=''
rebase_apply_path=''
original_head=''
original_ref=''

positionals=()
for arg in "$@"; do
  case "$arg" in
    --all|--stack)
      if [[ "$mode" != range && "$mode" != "${arg#--}" ]]; then
        echo '--all and --stack cannot be used together.' >&2
        exit 2
      fi
      mode="${arg#--}"
      ;;
    -*)
      usage
      exit 2
      ;;
    *)
      positionals+=("$arg")
      ;;
  esac
done

if [[ "$mode" == stack ]]; then
  if (( ${#positionals[@]} != 1 )) || [[ -z "${positionals[0]}" ]]; then
    usage
    exit 2
  fi
  base="${positionals[0]}"
elif [[ "$mode" == all ]]; then
  if (( ${#positionals[@]} > 1 )); then
    usage
    exit 2
  fi
  branch="${positionals[0]:-}"
else
  if (( ${#positionals[@]} > 2 )); then
    usage
    exit 2
  fi
  base="${positionals[0]:-}"
  branch="${positionals[1]:-}"
fi

if [[ -n "$branch" ]]; then
  if ! git show-ref --verify --quiet "refs/heads/$branch"; then
    echo "No local branch named '$branch'." >&2
    exit 1
  fi
  current_branch="$(git symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
  if [[ "$branch" == "$current_branch" ]]; then
    branch=''
  else
    if git worktree list --porcelain | grep -qxF "branch refs/heads/$branch"; then
      echo "Refusing to sign branch '$branch' because it is checked out in another worktree." >&2
      exit 1
    fi
    use_worktree=true
  fi
fi

target=HEAD
if [[ "$use_worktree" == true ]]; then
  target="refs/heads/$branch"
fi

if [[ "$mode" == range && -z "$base" ]]; then
  base="$(
    git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null \
      | sed 's@^refs/remotes/origin/@@' || true
  )"

  if [[ -z "$base" ]]; then
    if git show-ref --verify --quiet refs/heads/main; then
      base=main
    elif git show-ref --verify --quiet refs/heads/master; then
      base=master
    else
      echo "Unable to determine base branch. Pass one explicitly (for example: git sign-branch main)." >&2
      exit 1
    fi
  fi
fi

oldest_unsigned=''
if [[ "$mode" == stack ]]; then
  check_stack
fi
if [[ "$mode" == all ]]; then
  if [[ "$use_worktree" != true ]]; then
    rebase_merge_path="$(git rev-parse --git-path rebase-merge)"
    rebase_apply_path="$(git rev-parse --git-path rebase-apply)"
    if [[ -d "$rebase_merge_path" || -d "$rebase_apply_path" ]]; then
      echo 'Refusing to sign commits while a rebase is already in progress.' >&2
      exit 1
    fi
  fi

  while read -r commit; do
    if ! has_signature "$commit"; then
      oldest_unsigned="$commit"
      break
    fi
  done < <(git rev-list --reverse --topo-order "$target")

  if [[ -z "$oldest_unsigned" ]]; then
    exit 0
  fi

  if [[ "$use_worktree" != true ]]; then
    if ! git diff --quiet -- || ! git diff --cached --quiet --; then
      echo 'Refusing to sign commits with tracked index or worktree changes.' >&2
      exit 1
    fi
    original_head="$(git rev-parse HEAD)"
    original_ref="$(git symbolic-ref --quiet HEAD 2>/dev/null || true)"
  fi
fi

temp_dir="$(mktemp -d)"
trap cleanup_all EXIT
if [[ "$mode" == stack ]]; then
  trap 'handle_stack_interrupt 130' INT
  trap 'handle_stack_interrupt 143' TERM
elif [[ "$use_worktree" == true ]]; then
  trap handle_worktree_interrupt INT
elif [[ "$mode" == all ]]; then
  trap handle_interrupt INT
else
  trap cleanup_all INT TERM
fi
signed_log="$temp_dir/signed.log"
rebase_log="$temp_dir/rebase.log"

run=(git)
if [[ "$use_worktree" == true ]]; then
  worktree_dir="$temp_dir/worktree"
  original_tip="$(git rev-parse "refs/heads/$branch")"
  if ! git worktree add --detach "$worktree_dir" "refs/heads/$branch" \
    >"$temp_dir/worktree.log" 2>&1; then
    cat "$temp_dir/worktree.log" >&2
    exit 1
  fi
  run=(git -C "$worktree_dir")
fi

export SIGN_BRANCH_SIGNED_LOG="$signed_log"

if [[ "$mode" == stack ]]; then
  # Keep the exec command self-contained so --continue works after this script
  # exits. Retry failed signing commands before updating intermediate refs.
  sign_command='git commit --amend -S --no-edit --allow-empty'
  rebase_command=(
    "${run[@]}" rebase --update-refs --rebase-merges=no-rebase-cousins
    --no-autosquash --no-autostash --no-fork-point --force-rebase
    --reapply-cherry-picks --empty=keep --reschedule-failed-exec
    --exec "$sign_command" "$base"
  )
elif [[ "$mode" == all ]]; then
  sign_command="git commit --amend -S --no-edit --allow-empty >>\"\$SIGN_BRANCH_SIGNED_LOG\" 2>&1"
  if git rev-parse --verify --quiet "$oldest_unsigned^" >/dev/null; then
    rebase_command=(
      "${run[@]}" rebase --rebase-merges --no-autosquash --no-update-refs
      --reapply-cherry-picks
      --empty=keep --exec "$sign_command"
      "$oldest_unsigned^"
    )
  else
    rebase_command=(
      "${run[@]}" rebase --rebase-merges --no-autosquash --no-update-refs
      --reapply-cherry-picks
      --empty=keep --root --exec "$sign_command"
    )
  fi
else
  sign_command="if [ \"\$(git show -s --format=%G? HEAD)\" = N ]; then git commit --amend -S --no-edit >>\"\$SIGN_BRANCH_SIGNED_LOG\" 2>&1; fi"
  rebase_command=("${run[@]}" rebase)
  if [[ "$use_worktree" == true ]]; then
    rebase_command+=(--no-update-refs)
  fi
  rebase_command+=(--exec "$sign_command" "$base")
fi

if [[ "$mode" == all && "$use_worktree" != true ]]; then
  owns_rebase=true
fi

if ! "${rebase_command[@]}" >"$rebase_log" 2>&1; then
  rebase_errors="$(tr -d '\r' <"$rebase_log" | sed '/Rebasing (/d;/Executing:/d;/^Successfully rebased and updated /d;/^warning: execution failed:/d')"
  abort_status=0
  abort_output=''
  if [[ "$mode" == all && "$use_worktree" != true ]]; then
    if abort_output="$(restore_original_history 2>&1)"; then
      :
    else
      abort_status=$?
    fi
    owns_rebase=false
  fi
  if [[ -n "$rebase_errors" ]]; then
    printf '%s\n' "$rebase_errors" >&2
  fi
  if [[ -s "$signed_log" ]]; then
    cat "$signed_log" >&2
  fi
  if [[ "$use_worktree" == true ]]; then
    echo "Branch '$branch' did not change." >&2
  fi
  if [[ "$mode" == stack ]]; then
    stack_recovery_message
  fi
  if (( abort_status != 0 )); then
    printf 'Unable to abort failed rebase:\n%s\n' "$abort_output" >&2
  fi
  exit 1
fi

owns_rebase=false

if [[ "$use_worktree" == true ]]; then
  new_head="$("${run[@]}" rev-parse HEAD)"
  if ! git update-ref "refs/heads/$branch" "$new_head" "$original_tip"; then
    echo "Unable to update branch '$branch'; it moved while signing." >&2
    exit 1
  fi
fi

if [[ -s "$signed_log" ]]; then
  cat "$signed_log"
fi
